{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "X Account Seed Discovery Output",
  "description": "Output structure for X account seed discovery skill",
  "type": "object",
  "required": [
    "run_id",
    "topic",
    "region",
    "provider",
    "total_eligible",
    "total_not_eligible",
    "total_uncertain",
    "errors"
  ],
  "properties": {
    "run_id": {
      "type": "string",
      "description": "Unique identifier for this run",
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[a-z0-9]{6}$"
    },
    "topic": {
      "type": "string",
      "description": "Topic that was searched"
    },
    "region": {
      "type": "string",
      "description": "Region scope used"
    },
    "provider": {
      "type": "string",
      "description": "Provider configuration used"
    },
    "total_news_articles": {
      "type": "integer",
      "description": "Number of news articles fetched",
      "minimum": 0
    },
    "total_keywords": {
      "type": "integer",
      "description": "Number of keywords extracted",
      "minimum": 0
    },
    "total_x_posts": {
      "type": "integer",
      "description": "Number of X posts processed",
      "minimum": 0
    },
    "total_accounts_aggregated": {
      "type": "integer",
      "description": "Number of unique accounts found",
      "minimum": 0
    },
    "total_prefiltered": {
      "type": "integer",
      "description": "Number of accounts filtered by deterministic prefilter",
      "minimum": 0
    },
    "total_anti_wave_rejected": {
      "type": "integer",
      "description": "Number of accounts rejected by anti-wave filter",
      "minimum": 0
    },
    "total_ai_evaluated": {
      "type": "integer",
      "description": "Number of accounts evaluated by AI",
      "minimum": 0
    },
    "total_eligible": {
      "type": "integer",
      "description": "Number of eligible accounts",
      "minimum": 0
    },
    "total_not_eligible": {
      "type": "integer",
      "description": "Number of not eligible accounts",
      "minimum": 0
    },
    "total_uncertain": {
      "type": "integer",
      "description": "Number of uncertain accounts",
      "minimum": 0
    },
    "inserted_accounts": {
      "type": "integer",
      "description": "Number of new accounts inserted to database",
      "minimum": 0
    },
    "updated_accounts": {
      "type": "integer",
      "description": "Number of existing accounts updated",
      "minimum": 0
    },
    "skipped_duplicates": {
      "type": "integer",
      "description": "Number of duplicate accounts skipped in batch",
      "minimum": 0
    },
    "eligible_accounts": {
      "type": "array",
      "description": "List of eligible accounts (summary)",
      "items": {
        "type": "object",
        "required": ["handle", "decision"],
        "properties": {
          "handle": {
            "type": "string",
            "description": "Account handle"
          },
          "display_name": {
            "type": "string",
            "description": "Account display name"
          },
          "followers_count": {
            "type": "integer",
            "description": "Number of followers",
            "minimum": 0
          },
          "decision": {
            "type": "string",
            "enum": ["eligible"],
            "description": "Decision (always 'eligible' in this list)"
          },
          "score": {
            "type": "integer",
            "description": "Quality score (0-100)",
            "minimum": 0,
            "maximum": 100
          },
          "reason_short": {
            "type": "string",
            "description": "Brief explanation of decision"
          }
        }
      }
    },
    "sample_evaluations": {
      "type": "array",
      "description": "Sample of evaluations across all decisions",
      "items": {
        "type": "object",
        "properties": {
          "handle": {
            "type": "string"
          },
          "decision": {
            "type": "string",
            "enum": ["eligible", "not_eligible", "uncertain"]
          },
          "score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "reason_short": {
            "type": "string"
          }
        }
      }
    },
    "errors": {
      "type": "array",
      "description": "List of errors encountered during run",
      "items": {
        "type": "object",
        "required": ["stage", "message"],
        "properties": {
          "stage": {
            "type": "string",
            "description": "Pipeline stage where error occurred",
            "enum": [
              "input_validation",
              "news_search",
              "keyword_extraction",
              "x_search",
              "account_aggregation",
              "anti_wave_filter",
              "ai_evaluation",
              "persistence",
              "export"
            ]
          },
          "account_handle": {
            "type": "string",
            "description": "Account handle if error was account-specific"
          },
          "message": {
            "type": "string",
            "description": "Error message"
          },
          "details": {
            "type": "object",
            "description": "Additional error details"
          }
        }
      }
    },
    "started_at": {
      "type": "string",
      "format": "date-time",
      "description": "Run start timestamp (ISO 8601)"
    },
    "finished_at": {
      "type": "string",
      "format": "date-time",
      "description": "Run end timestamp (ISO 8601)"
    },
    "duration_seconds": {
      "type": "number",
      "description": "Total run duration in seconds",
      "minimum": 0
    },
    "dry_run": {
      "type": "boolean",
      "description": "Whether this was a dry run (no DB writes)"
    }
  },
  "additionalProperties": false,
  "examples": [
    {
      "run_id": "20260330T100000Z-abc123",
      "topic": "government",
      "region": "Indonesia",
      "provider": "default",
      "total_news_articles": 16,
      "total_keywords": 28,
      "total_x_posts": 240,
      "total_accounts_aggregated": 97,
      "total_prefiltered": 71,
      "total_anti_wave_rejected": 14,
      "total_ai_evaluated": 57,
      "total_eligible": 21,
      "total_not_eligible": 28,
      "total_uncertain": 8,
      "inserted_accounts": 17,
      "updated_accounts": 40,
      "skipped_duplicates": 25,
      "eligible_accounts": [
        {
          "handle": "example",
          "display_name": "Example Account",
          "followers_count": 25000,
          "decision": "eligible",
          "score": 89,
          "reason_short": "Akun rutin membahas isu pemerintahan Indonesia."
        }
      ],
      "errors": [],
      "started_at": "2026-03-30T10:00:00Z",
      "finished_at": "2026-03-30T10:15:30Z",
      "duration_seconds": 930,
      "dry_run": false
    }
  ]
}
